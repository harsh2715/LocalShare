{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalShare",
  "mainBinaryName": "localshare",
  "version": "0.1.0",
  "identifier": "com.localshare.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "LocalShare", "width": 1180, "height": 780, "minWidth": 900, "minHeight": 620, "resizable": true }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": ["app", "dmg", "msi", "nsis"], "createUpdaterArtifacts": false, "macOS": { "minimumSystemVersion": "11.0" }, "windows": { "webviewInstallMode": { "type": "offlineInstaller" } } }
}
