{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalShare",
  "version": "1.1.0",
  "identifier": "com.localshare.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out/renderer",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": { "windows": [{ "title": "LocalShare", "width": 1280, "height": 820, "resizable": true }], "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173" } },
  "bundle": { "active": true, "targets": ["app", "dmg"] }
}
