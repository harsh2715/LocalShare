{
  "name": "localshare",
  "version": "1.0.0",
  "description": "Private peer-to-peer LAN chat and file sharing.",
  "author": "LocalShare",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:app": "tauri build --bundles app",
    "core:check": "cargo check --workspace",
    "core:test": "cargo test --workspace",
    "test-node": "cargo run -p localshare-test-node --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@tauri-apps/cli": "^2.5.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  }
}
